    "route_id": "jezreel-valley",
    "name": "Jezreel Valley Railway",
    "name_arabic": "سكة حديد مرج ابن عامر",
    "countries": "Israel, Jordan, Syria",
    "gauge_mm": 1050,
    "year_opened": 1905,
