{
  "type": "FeatureCollection",
  "route": {
    "route_id": "aqaba-branch",
    "name": "Aqaba Railway (Ma'an-Aqaba)",
    "name_arabic": "خط سكة حديد العقبة",
    "countries": "Jordan",
    "gauge_mm": 1050,
    "year_opened": 1975,
    "era": "historic",
    "color": "#b45309",
    "corridor_confidence": "medium",
    "description": "1970s phosphate line to the Red Sea; freight ceased 2018",
    "notes": "Built 1975 on the Hejaz 1,050 mm gauge; operated by the Aqaba Railway Corporation from 1979. Ma'an to the Red Sea port of Aqaba, with a spur to the Shidiya phosphate mine (held as an off-line extra_station); freight-only (phosphate), GE U17C diesels. Part of the route reused the trackbed of the southern Hejaz Railway. Operations ended c.2012–2018 (sources differ — port/terminal relocation left it unconnected). A 14 km section at Wadi Rum (Ad Disah–Shakaria) survives for tourist steam excursions. Note: distinct from the 1942 Australian-built Ma'an–Abu Lissan–Ras al-Naqab line (which ended at the cliff; phosphate went onward by truck) and from the proposed US$2.3bn standard-gauge Aqaba line. Intermediate desert stations not individually documented here.",
    "history": "A 1,050 mm narrow-gauge freight line built in 1975 by the Hejaz Jordan Railway from Ma'an to the Red Sea port of Aqaba to haul phosphate (from the Shidiya mine) and sulphur; the Aqaba Railway Corporation took over operations in 1979.",
    "verification_status": "unverified",
    "source_ids": [
      "levantrain_compilation",
      "levantrain_system",
      "wp_jordan"
    ]
  },
